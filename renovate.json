{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>skunklabs-uk/renovate-config"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "npm"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchDepTypes": [
        "action"
      ],
      "enabled": false
    },
    {
      "description": "Una PR per repository upstream, solo nella finestra settimanale e senza automerge.",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "git-refs"
      ],
      "matchFileNames": [
        "config/global-skill-upstreams.tsv"
      ],
      "groupName": "upstream skills: {{{depName}}}",
      "automerge": false,
      "schedule": [
        "* 0-5 * * 1"
      ],
      "updateNotScheduled": false,
      "minimumReleaseAge": null
    }
  ],
  "timezone": "Europe/Rome",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Aggiorna gli SHA del manifest senza modificare nomi o percorsi delle skill.",
      "managerFilePatterns": [
        "/^config/global-skill-upstreams\\.tsv$/"
      ],
      "matchStrings": [
        "(?:^|\\r?\\n)[a-z0-9][a-z0-9-]*\\t(?<packageName>https://github\\.com/(?<depName>[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)\\.git)\\t(?<currentDigest>[0-9a-fA-F]{40})\\t[^\\t\\r\\n]+"
      ],
      "datasourceTemplate": "git-refs"
    }
  ]
}
